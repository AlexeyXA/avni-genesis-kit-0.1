{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avni.invalid/schemas/genome-0.1.schema.json",
  "title": "AVNI Genome 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "organism", "runtime", "artifacts", "interface", "secrets"],
  "properties": {
    "format": {"const": "avni.genome"},
    "format_version": {"const": "0.1"},
    "organism": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["language", "python", "entrypoint"],
      "properties": {
        "language": {"const": "python"},
        "python": {"type": "string"},
        "entrypoint": {"type": "string", "pattern": "^[^:]+:run$"},
        "network": {"type": "string"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "interface": {"type": "object"},
    "secrets": {
      "type": "object",
      "required": ["required_env", "package_values"],
      "properties": {
        "required_env": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}},
        "package_values": {"const": false}
      },
      "additionalProperties": false
    },
    "metadata": {"type": "object"}
  }
}
